#!/usr/bin/env bash
# daemon-code — local dev backend env vars
# 1. Copy to .env.local
# 2. Fill in the four <retrieve...> placeholders from AWS Secrets Manager
# 3. source .env.local && go run ./backend/cmd/localserver

export AWS_PROFILE=daemon-code
export AWS_REGION=us-east-1

# ── Database (RDS — publicly accessible in dev) ──────────────────────────────
export DB_HOST=daemon-code-dev.c0xg6kaa8m66.us-east-1.rds.amazonaws.com
export DB_PORT=5432
export DB_NAME=daemoncode
export DB_USER=daemoncode
export DB_PASSWORD=<retrieve from Secrets Manager: daemon-code-db-dev>

# ── Secrets (retrieve from AWS Secrets Manager) ──────────────────────────────
export JWT_SECRET=<retrieve from Secrets Manager: daemon-code-jwt-dev>
export ANTHROPIC_API_KEY=<retrieve from Secrets Manager: daemon-code-anthropic-dev>
export VAPID_PUBLIC_KEY=<public_key field from Secrets Manager: daemon-code-vapid-dev>
export VAPID_PRIVATE_KEY=<private_key field from Secrets Manager: daemon-code-vapid-dev>

# ── AWS resources (from terraform outputs) ───────────────────────────────────
export AUDIO_BUCKET=daemon-code-audio-567768661010
export DYNAMO_TABLE_DECKS=daemon-code-daily-decks
export DYNAMO_TABLE_STATE=daemon-code-shadow-state
export SQS_ANALYST_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/567768661010/daemon-code-analyst
export EVENT_BUS_NAME=daemon-code-events
export ENVIRONMENT=local

# STATIC_DOMAIN is no longer used. Audio URLs are S3 presigned URLs generated
# by the /home handler at request time. No env var needed.
