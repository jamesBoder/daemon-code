# Backend — local dev only
# Copy to backend/.env.local (gitignored) and fill in the <retrieve…> placeholders.
# Run from repo root: source backend/.env.local && go run ./backend/cmd/localserver
#
# ARN vars are intentionally left empty — config.Load() skips Secrets Manager
# when ARNs are absent and falls back to the plain vars below.

# ── AWS ──────────────────────────────────────────────────────────────────────
export AWS_REGION=us-east-1
export AWS_PROFILE=daemon-code

# ── Database (RDS dev — publicly accessible) ─────────────────────────────────
# Retrieve:
#   AWS_PROFILE=daemon-code aws secretsmanager get-secret-value \
#     --secret-id daemon-code-db-dev --query SecretString --output text | \
#     python3 -c "import sys,json; d=json.load(sys.stdin); print(d['host'],d['port'],d['dbname'],d['username'],d['password'])"
export DB_HOST=<retrieve from daemon-code-db-dev: host>
export DB_PORT=5432
export DB_NAME=daemoncode
export DB_USER=daemoncode
export DB_PASSWORD=<retrieve from daemon-code-db-dev: password>

# ── JWT ───────────────────────────────────────────────────────────────────────
# Retrieve:
#   AWS_PROFILE=daemon-code aws secretsmanager get-secret-value \
#     --secret-id daemon-code-jwt-dev --query SecretString --output text
export JWT_SECRET=<retrieve from daemon-code-jwt-dev>

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Retrieve:
#   AWS_PROFILE=daemon-code aws secretsmanager get-secret-value \
#     --secret-id daemon-code-anthropic-dev --query SecretString --output text
export ANTHROPIC_API_KEY=<retrieve from daemon-code-anthropic-dev>

# ── VAPID (push notifications) ────────────────────────────────────────────────
# Retrieve:
#   AWS_PROFILE=daemon-code aws secretsmanager get-secret-value \
#     --secret-id daemon-code-vapid-dev --query SecretString --output text | \
#     python3 -c "import sys,json; d=json.load(sys.stdin); print(d['public_key']); print(d['private_key'])"
export VAPID_PUBLIC_KEY=<retrieve from daemon-code-vapid-dev: public_key>
export VAPID_PRIVATE_KEY=<retrieve from daemon-code-vapid-dev: private_key>

# ── DynamoDB ──────────────────────────────────────────────────────────────────
export DYNAMO_TABLE_DECKS=daemon-code-daily-decks
export DYNAMO_TABLE_STATE=daemon-code-shadow-state

# ── S3 / Audio ────────────────────────────────────────────────────────────────
# Bucket name includes account ID (daemon-code account: 567768661010)
export AUDIO_BUCKET=daemon-code-audio-567768661010

# ── SQS / EventBridge ─────────────────────────────────────────────────────────
# Retrieve queue URL:
#   AWS_PROFILE=daemon-code aws sqs get-queue-url \
#     --queue-name daemon-code-analyst --query QueueUrl --output text
export SQS_ANALYST_QUEUE_URL=<retrieve queue URL>
export EVENT_BUS_NAME=daemon-code-events

# ── Server ────────────────────────────────────────────────────────────────────
export ENVIRONMENT=development
export ALLOWED_ORIGIN=http://localhost:5174
